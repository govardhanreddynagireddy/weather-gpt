# =====================================================
# WeatherGPT+ Environment Configuration Template
# Copy to .env and fill in your API keys
# =====================================================

# OpenWeatherMap API Key (Required for real-time weather & forecast)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API Key (Required for natural language generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Server Port (Optional, defaults to 8000 or $PORT on Render)
PORT=8000
